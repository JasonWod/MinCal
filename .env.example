# MinCal 部署配置样例
# 用法：cp .env.example .env 然后填入真实值；.env 不会被提交
# docker compose 会自动读取同目录下的 .env

# PostgreSQL 连接串（asyncpg 驱动）
DATABASE_URL=postgresql+asyncpg://mincal:<强密码>@<PG主机>:5432/mincal

# JWT 签名密钥：必须随机生成 —— openssl rand -hex 32
JWT_SECRET=<openssl rand -hex 32 的输出>

# 允许访问的客户端来源，逗号分隔（按 LAN / 隧道网段填写）
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://<客户端IP>
